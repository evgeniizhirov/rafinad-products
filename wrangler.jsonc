{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "products-roadmap",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  // Client bundle is built by esbuild before every deploy / dev run.
  "build": {
    "command": "node scripts/build-client.mjs"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The worker sees every request: it serves /api/* and adds security headers to static files.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "products-roadmap-db",
      "database_id": "36a18f66-5d92-47ca-a121-a806094563b1",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Preserve integration keys configured in Dashboard; never store them in Git.
  "keep_vars": true,
  "vars": { "INBOX_INGEST_ENABLED": "1" },
  "triggers": { "crons": ["* * * * *"] }
  // Secrets (set with `wrangler secret put <NAME>`, never commit them):
  //   GOOGLE_SERVICE_ACCOUNT_JSON — JSON key of a read-only Google service account
  //   INBOX_INGEST_KEYS — JSON map of connection IDs to independent ingest secrets
}
