{
  "name": "rafinad-roadmap-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:ci": "tsx --test tests/security.test.ts tests/client.test.ts tests/auth0-compat.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc -p tsconfig.ci.json",
    "dev": "wrangler dev",
    "dryrun": "wrangler deploy --dry-run --outdir dist",
    "build": "pnpm run typecheck:ci && pnpm run test:ci && pnpm run dryrun",
    "diagnose": "node scripts/diagnose.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.10.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "wrangler": "^4.20.0"
  }
}
